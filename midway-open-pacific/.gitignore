# ThreeNative local authoring state and dependency secrets
.dream-loop/
node_modules/
.env
.env.*
!.env.example

# Captured frames are local debugging evidence, not shipped source. The folder itself stays.
screenshots/*
!screenshots/.gitkeep
.afk/

# `vite build` copies and content-hashes everything under assets/ into public/, so the cooked
# output lives there under names that change on every rebuild. Sources stay in assets/; only the
# authored icons are source in public/.
public/*
!public/favicon.svg
!public/icon.png
