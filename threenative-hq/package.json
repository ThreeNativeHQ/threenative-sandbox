{
  "name": "threenative-hq",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "studio": "threenative-studio",
    "build": "threenative build",
    "build:web": "threenative build --target web",
    "build:desktop": "threenative build --target desktop",
    "build:android": "threenative build --target android",
    "build:ios": "threenative build --target ios",
    "test:native": "pnpm build:desktop && node node_modules/@threenative/runtime-native/scripts/verify-starter-desktop.mjs",
    "pretest": "playwright install chromium",
    "test": "pnpm test:bridge && vite build && node tools/run-playtests.mjs",
    "test:bridge": "tsx tools/office-bridge/registry.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "office": "tsx tools/office-bridge/main.ts",
    "assets:trim": "node tools/trim-clips.mjs",
    "office:fixture": "tsx tools/office-bridge/fixture.ts",
    "inspect": "node tools/inspect.mjs"
  },
  "dependencies": {
    "@threenative/core": "0.3.6",
    "@threenative/physics": "0.3.6",
    "@threenative/ui": "0.3.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-reconciler": "0.33.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.4.2",
    "@gltf-transform/core": "^4.5.0",
    "@tailwindcss/vite": "4.3.3",
    "@threenative/assets": "0.3.7",
    "@threenative/playtest": "0.3.6",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/three": "0.185.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.0.5",
    "create-threenative": "0.2.10",
    "esbuild": "0.27.0",
    "playwright": "1.62.1",
    "tailwindcss": "4.3.3",
    "threenative-engine-mcp": "0.2.6",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.0",
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "@threenative/runtime-native": "0.3.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@threenative/core",
      "@threenative/runtime-native"
    ]
  }
}
