{
  "name": "starlance",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "studio": "threenative-studio",
    "build": "threenative build",
    "build:web": "threenative build --target web",
    "build:desktop": "threenative build --target desktop",
    "build:android": "threenative build --target android",
    "build:ios": "threenative build --target ios",
    "pretest": "playwright install chromium",
    "test": "pnpm check && pnpm build:web && threenative-playtest --scenario \"playtests/*.playtest.json\" --browser-recipe webgpu --headed --server-command \"pnpm exec vite preview --host 127.0.0.1 --port $PORT --strictPort\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "lint": "eslint src",
    "format:check": "biome format src"
  },
  "dependencies": {
    "@threenative/core": "0.3.12",
    "@threenative/physics": "0.3.12",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@gltf-transform/cli": "4.4.2",
    "@threenative/assets": "0.3.13",
    "@threenative/playtest": "0.3.12",
    "@types/three": "0.187.0",
    "create-threenative": "file:../.packages/create-threenative-0.2.17-prd829-830-0251de582fd0.tgz",
    "esbuild": "0.27.0",
    "eslint": "10.13.0",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  },
  "optionalDependencies": {
    "@threenative/runtime-native": "0.3.12"
  },
  "overrides": {
    "sharp": ">=0.35.4",
    "@vitejs/devtools": "0.4.1"
  },
  "pnpm": {
    "overrides": {
      "sharp": ">=0.35.4"
    },
    "onlyBuiltDependencies": [
      "@threenative/core",
      "@threenative/runtime-native"
    ],
    "patchedDependencies": {
      "three@0.187.0": "patches/three@0.187.0.patch",
      "vite@8.2.0": "patches/vite@8.2.0.patch"
    }
  }
}
