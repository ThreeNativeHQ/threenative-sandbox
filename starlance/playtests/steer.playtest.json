{
  "name": "steer",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 30,
  "subject": "ship",
  "steps": [
    {
      "kind": "wait",
      "label": "rest",
      "waitTicks": 60,
      "release": true,
      "screenshot": "rest"
    },
    {
      "kind": "input",
      "label": "right",
      "press": "ArrowRight",
      "holdTicks": 40,
      "release": true,
      "screenshot": "steer-right-mid"
    },
    {
      "kind": "input",
      "label": "right-edge",
      "press": "ArrowRight",
      "holdTicks": 110,
      "release": true,
      "screenshot": "steer-right-edge"
    },
    {
      "kind": "input",
      "label": "up",
      "press": "ArrowUp",
      "holdTicks": 90,
      "release": true,
      "screenshot": "steer-up"
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "runtimeReady": true
    },
    "components": [
      {
        "entity": "ship",
        "component": "offsetX",
        "gte": 13.9,
        "lte": 14.0001
      },
      {
        "entity": "ship",
        "component": "offsetY",
        "gte": 5,
        "lte": 13.6001
      },
      {
        "entity": "ship",
        "component": "edgeWarning",
        "equals": true
      }
    ]
  }
}
