{
  "name": "uturn",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 30,
  "subject": "ship",
  "steps": [
    {
      "kind": "wait",
      "label": "arena",
      "waitTicks": 240,
      "release": true,
      "screenshot": "arena"
    },
    {
      "kind": "input",
      "label": "turn",
      "press": [
        "KeyW",
        "KeyC"
      ],
      "holdTicks": 4,
      "release": true
    },
    {
      "kind": "wait",
      "label": "mid-turn",
      "waitTicks": 30,
      "release": true,
      "screenshot": "arena-uturn"
    },
    {
      "kind": "wait",
      "label": "flipped",
      "waitTicks": 90,
      "release": true,
      "screenshot": "arena-flipped"
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "runtimeReady": true
    },
    "components": [
      {
        "entity": "ship",
        "component": "uturns",
        "equals": 1
      },
      {
        "entity": "ship",
        "component": "heading",
        "gte": 167,
        "lte": 207
      },
      {
        "entity": "ship",
        "component": "arenaDistance",
        "lte": 300.5,
        "changed": true
      }
    ]
  }
}
