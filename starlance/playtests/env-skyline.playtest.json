{
  "name": "env-skyline",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 30,
  "subject": "ship",
  "steps": [
    {
      "kind": "wait",
      "label": "settle",
      "waitTicks": 30,
      "release": true
    },
    {
      "kind": "wait",
      "label": "skyline",
      "waitTicks": 90,
      "release": true,
      "screenshot": "skyline"
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "runtimeReady": true
    },
    "performance": {
      "maxDrawCalls": 160
    },
    "visual": [
      {
        "region": {
          "x": 0,
          "y": 0,
          "width": 1280,
          "height": 720,
          "minNonblankPixelRatio": 0.9
        }
      }
    ]
  }
}
