{
  "name": "mouse-aim",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 30,
  "subject": "ship",
  "steps": [
    {
      "kind": "wait",
      "label": "rest",
      "waitTicks": 60,
      "release": true
    },
    {
      "kind": "input",
      "label": "cursor-right",
      "pointerPosition": {
        "x": 0.95,
        "y": 0.5
      },
      "holdTicks": 150,
      "release": false,
      "screenshot": "mouse-right"
    },
    {
      "kind": "input",
      "label": "cursor-up",
      "pointerPosition": {
        "x": 0.5,
        "y": 0.05
      },
      "holdTicks": 90,
      "release": false,
      "screenshot": "mouse-up"
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "runtimeReady": true
    },
    "components": [
      {
        "entity": "ship",
        "component": "offsetX",
        "gte": 13.9,
        "lte": 14.0001
      },
      {
        "entity": "ship",
        "component": "offsetY",
        "gte": 5,
        "lte": 13.6001
      },
      {
        "entity": "ship",
        "component": "edgeWarning",
        "equals": true
      }
    ]
  }
}
