{
  "name": "smoke",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 30,
  "subject": "ship",
  "steps": [
    { "kind": "wait", "label": "cruise", "waitTicks": 120, "release": true, "screenshot": "cruise" },
    { "kind": "input", "label": "steer-right", "press": "ArrowRight", "holdTicks": 60, "release": true, "screenshot": "steer-right" }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "runtimeReady": true },
    "movement": { "entity": "ship", "minDistance": 50 },
    "resources": [{ "id": "state", "path": "distance", "changed": true }],
    "visual": [{ "region": { "x": 0, "y": 0, "width": 1280, "height": 720, "minNonblankPixelRatio": 0.5 } }]
  }
}
