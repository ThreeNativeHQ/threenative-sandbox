{
  "name": "lock-on",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 30,
  "subject": "ship",
  "steps": [
    {
      "kind": "input",
      "label": "hold-right-click",
      "pointerPosition": {
        "x": 0.5,
        "y": 0.5,
        "buttons": 2
      },
      "holdTicks": 60,
      "release": false,
      "screenshot": "charged"
    },
    {
      "kind": "input",
      "label": "release",
      "pointerPosition": {
        "x": 0.5,
        "y": 0.5,
        "buttons": 0
      },
      "holdTicks": 10,
      "release": true,
      "screenshot": "homing"
    },
    {
      "kind": "wait",
      "label": "settle",
      "waitTicks": 60,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "runtimeReady": true
    },
    "components": [
      {
        "entity": "weapons",
        "component": "homingShots",
        "gte": 1
      }
    ]
  }
}
