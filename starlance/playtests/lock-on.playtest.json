{
  "name": "lock-on",
  "target": "web", "schemaVersion": 1, "viewport": { "width": 1280, "height": 720 }, "warmupFrames": 30, "subject": "ship",
  "steps": [
    { "kind": "input", "label": "charge", "press": "Space", "holdTicks": 60, "release": true, "screenshot": "charged" },
    { "kind": "wait", "label": "flight", "waitTicks": 10, "release": true, "screenshot": "homing" },
    { "kind": "wait", "label": "settle", "waitTicks": 60, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "runtimeReady": true },
    "components": [
      { "entity": "weapons", "component": "homingShots", "gte": 1 }
    ]
  }
}
