{
  "name": "cockpit-look",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "warmupFrames": 30,
  "subject": "ship",
  "steps": [
    {
      "kind": "wait",
      "label": "chase",
      "waitTicks": 60,
      "release": true
    },
    {
      "kind": "input",
      "label": "cockpit-on",
      "press": "KeyC",
      "holdTicks": 3,
      "release": true
    },
    {
      "kind": "wait",
      "label": "rest",
      "waitTicks": 40,
      "release": true,
      "screenshot": "rest"
    },
    {
      "kind": "input",
      "label": "roll-right",
      "press": "KeyD",
      "holdTicks": 60,
      "release": false,
      "screenshot": "roll-right"
    },
    {
      "kind": "wait",
      "label": "level",
      "waitTicks": 80,
      "release": true,
      "screenshot": "level"
    },
    {
      "kind": "input",
      "label": "pitch-down",
      "press": "KeyS",
      "holdTicks": 60,
      "release": false,
      "screenshot": "pitch-down"
    },
    {
      "kind": "wait",
      "label": "level3",
      "waitTicks": 60,
      "release": true
    },
    {
      "kind": "wait",
      "label": "end",
      "waitTicks": 30,
      "release": true,
      "screenshot": "end"
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "runtimeReady": true
    },
    "components": [
      {
        "entity": "camera",
        "component": "cockpit",
        "atSteps": [
          {
            "label": "chase",
            "equals": false
          },
          {
            "label": "rest",
            "equals": true
          }
        ]
      },
      {
        "entity": "camera",
        "component": "hudShown",
        "atSteps": [
          {
            "label": "rest",
            "equals": 1
          }
        ]
      },
      {
        "entity": "camera",
        "component": "hudQuads",
        "gte": 8
      },
      {
        "entity": "camera",
        "component": "hudRollDeg",
        "changed": true
      },
      {
        "entity": "camera",
        "component": "hudPitchDeg",
        "changed": true
      },
      {
        "entity": "camera",
        "component": "hudRolled",
        "atSteps": [
          {
            "label": "rest",
            "equals": 0
          },
          {
            "label": "roll-right",
            "equals": 1
          }
        ]
      },
      {
        "entity": "camera",
        "component": "hudPitchMin",
        "lte": -10
      },
      {
        "entity": "camera",
        "component": "hudRollAbsMax",
        "gte": 15
      }
    ]
  }
}
