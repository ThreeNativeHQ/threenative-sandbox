# ThreeNative local authoring state and dependency secrets
.dream-loop/
.threenative/discovery-gate.json
node_modules/
.env
.env.*
!.env.example
public/assets.manifest.json
public/bake.receipt.json
public/*.[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].*

# Captures are local debugging evidence, not the durable record: the sandbox's own convention keeps
# the marker and nothing else (AGENTS.md, "A new game is committed and pushed").
screenshots/*
!screenshots/.gitkeep

# `threenative build`'s report beside the staged artifact; regenerated by every build.
dist.build-report.json
