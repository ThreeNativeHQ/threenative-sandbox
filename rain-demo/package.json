{
  "name": "rain-demo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "threenative build",
    "build:web": "threenative build --target web",
    "build:desktop": "threenative build --target desktop",
    "build:android": "threenative build --target android",
    "build:ios": "threenative build --target ios",
    "pretest": "playwright install chromium",
    "test": "pnpm build:web && threenative-playtest --scenario \"playtests/*.playtest.json\" --browser-recipe webgpu --headed --server-command \"pnpm exec vite preview --host 127.0.0.1 --port $PORT --strictPort\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@threenative/core": "0.3.6",
    "@threenative/ui": "0.3.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-reconciler": "0.33.0",
    "three": "0.185.1",
    "threenative-blender-mcp": "0.1.6",
    "@threenative/metahuman": "0.1.2",
    "@threenative/physics": "0.3.6",
    "@threenative/raw-unreal": "0.1.6",
    "@threenative/ueformat": "0.1.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@threenative/assets": "0.3.7",
    "@threenative/playtest": "0.3.6",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/three": "0.185.3",
    "@vitejs/plugin-react": "6.0.5",
    "create-threenative": "0.2.10",
    "esbuild": "0.27.0",
    "playwright": "1.62.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.0",
    "@gltf-transform/cli": "4.4.2",
    "threenative-engine-mcp": "0.2.6"
  },
  "optionalDependencies": {
    "@threenative/runtime-native": "0.3.6"
  },
  "overrides": {
    "sharp": ">=0.35.4"
  },
  "pnpm": {
    "overrides": {
      "sharp": ">=0.35.4"
    },
    "onlyBuiltDependencies": [
      "@threenative/core",
      "@threenative/runtime-native"
    ]
  }
}
