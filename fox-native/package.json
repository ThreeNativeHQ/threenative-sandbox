{
  "name": "fox-native",
  "private": true,
  "type": "module",
  "threenative": {
    "nativeEntry": "src/game.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "threenative build",
    "build:web": "threenative build --target web",
    "build:desktop": "threenative build --target desktop",
    "build:android": "threenative build --target android",
    "build:ios": "threenative build --target ios",
    "pretest": "playwright install chromium",
    "test": "vite build && threenative-playtest --scenario \"playtests/*.playtest.json\" --browser-recipe webgpu --headed --url http://127.0.0.1:4173 --server-command \"pnpm dev --host 127.0.0.1 --port 4173 --strictPort\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@threenative/core": "0.3.6",
    "@threenative/physics": "0.3.6",
    "three": "0.185.1",
    "@threenative/ui": "0.3.6"
  },
  "devDependencies": {
    "@types/three": "0.185.3",
    "@threenative/playtest": "0.3.6",
    "create-threenative": "0.2.10",
    "playwright": "1.62.1",
    "threenative-asset-mcp": "0.4.0",
    "threenative-sculpt-mcp": "0.1.0",
    "typescript": "5.9.3",
    "vite": "8.2.0"
  },
  "optionalDependencies": {
    "@threenative/runtime-native": "0.3.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@threenative/runtime-native"
    ]
  }
}
